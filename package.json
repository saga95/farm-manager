{
  "name": "farm-manager",
  "version": "0.0.0-semantically-released",
  "private": true,
  "description": "My Smart Need AgriTech — multi-tenant, mobile-first Smart Farm & Garden Management platform (Next.js + AWS Amplify Gen 2).",
  "author": "saga95",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saga95/farm-manager.git"
  },
  "homepage": "https://github.com/saga95/farm-manager",
  "keywords": [
    "farm-management",
    "agritech",
    "nextjs",
    "aws-amplify",
    "pwa"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "scan:bundle": "node scripts/scan-client-bundle.mjs",
    "budget:js": "node scripts/check-bundle-budget.mjs",
    "budget:lighthouse": "node scripts/lighthouse-budget.mjs",
    "start": "next start",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "prepare": "husky",
    "amplify:outputs:dev": "npx ampx generate outputs --branch development --app-id $AMPLIFY_APP_ID",
    "amplify:deploy": "npx ampx pipeline-deploy",
    "bootstrap": "bash scripts/bootstrap.sh",
    "audit": "pnpm audit --audit-level=critical",
    "quality:quick": "pnpm lint:check && pnpm type-check && pnpm test",
    "quality": "pnpm format:check && pnpm lint:check && pnpm type-check && pnpm test:coverage && pnpm audit",
    "analyze": "ANALYZE=true next build",
    "seo:mcp:dev": "cd tools/seo-intelligence-mcp && npx tsx watch src/index.ts",
    "seo:mcp:build": "cd tools/seo-intelligence-mcp && npx tsc",
    "seo:mcp:start": "node tools/seo-intelligence-mcp/dist/index.js",
    "test:e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.0.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1125.0",
    "@emailjs/browser": "^4.4.1",
    "@emotion/cache": "^11",
    "@emotion/react": "^11.13.3",
    "@emotion/server": "^11",
    "@emotion/styled": "^11.13.0",
    "@fontsource/dm-sans": "^5",
    "@hookform/resolvers": "^3.9.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@mui/material-nextjs": "^6",
    "@tanstack/react-query": "^4.36.1",
    "aws-amplify": "^6.0.0",
    "critters": "^0.0.23",
    "dayjs": "^1.11.13",
    "dompurify": "^3.3.3",
    "i18next": "^23.16.4",
    "i18next-browser-languagedetector": "^8.0.2",
    "i18next-http-backend": "^2.6.2",
    "next": "14.2.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.1.0",
    "ulid": "^3.0.2",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.24.0",
    "@aws-amplify/backend-cli": "^1.9.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^8.57.1",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/experimental-nextjs-vite": "8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "aws-cdk-lib": "^2.268.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "esbuild": "^0.25",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.25",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.0.0",
    "next-router-mock": "^1.0.2",
    "prettier": "^3.3.3",
    "semantic-release": "^25.0.9",
    "storybook": "^8.6.18",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "pnpm": {
    "overrides": {},
    "auditConfig": {
      "ignoreCves": []
    }
  }
}
